# Server
HOST=0.0.0.0
PORT=5121
# Public URL of this Strapi instance (admin panel + absolute media URLs)
PUBLIC_URL=http://localhost:5121

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/portfolio
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Secrets: generate each with `openssl rand -base64 32`
# APP_KEYS is a comma-separated list (two or more keys)
APP_KEYS=changeme1,changeme2
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Optional: refresh the web app when content changes
WEB_REVALIDATE_URL=http://localhost:5101/api/revalidate
REVALIDATE_SECRET=changeme
