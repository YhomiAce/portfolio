# Strapi base URL (build + runtime). If unset or unreachable, bundled content is used.
STRAPI_URL=http://127.0.0.1:5121
# Optional read-only Strapi API token (runtime)
STRAPI_API_TOKEN=
# Shared secret for POST /api/revalidate?secret=... (runtime; must match the CMS)
REVALIDATE_SECRET=dev-revalidate-secret-change-me
# Public URL of this site (build time: canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:5101
