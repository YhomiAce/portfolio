{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Projects; featured ones appear on the home page"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "product",
        "infrastructure"
      ],
      "default": "product"
    },
    "role": {
      "type": "string"
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 400
    },
    "description": {
      "type": "blocks"
    },
    "tech": {
      "type": "json"
    },
    "repoUrl": {
      "type": "string"
    },
    "liveUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
